---
import { defaultLanguage, languages, type Language } from '../i18n/ui';
import { localizedPath, stripLocalePrefix } from '../i18n/utils';

interface Props {
  currentLang: Language;
  pathname: string;
  label: string;
}

const { currentLang, pathname, label } = Astro.props;

const basePath = stripLocalePrefix(pathname);

const getHref = (lang: Language): string => {
  if (lang === defaultLanguage) {
    return basePath;
  }
  return localizedPath(lang, basePath);
};
---

<details class="relative group text-xs font-semibold text-(--color-text-muted)">
  <summary
    class="list-none flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-(--color-border) dark:border-(--color-border-dark) hover:border-(--color-brand) hover:text-(--color-text-main) transition-colors cursor-pointer select-none"
    aria-label={label}
  >
    <span class="tracking-wide">{currentLang.toUpperCase()}</span>
    <svg class="w-3.5 h-3.5 opacity-70 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </summary>

  <div class="absolute right-0 mt-2 min-w-20 rounded-md border border-(--color-border) dark:border-(--color-border-dark) bg-white dark:bg-(--color-surface-dark) shadow-lg overflow-hidden z-50">
    {Object.entries(languages).map(([langCode]) => {
      const lang = langCode as Language;
      const isActive = currentLang === lang;

      return (
        <a
          href={getHref(lang)}
          hreflang={lang}
          aria-current={isActive ? 'page' : undefined}
          class={`block px-3 py-2 text-center tracking-wide transition-colors ${
            isActive
              ? 'text-(--color-brand) bg-(--color-brand)/8'
              : 'hover:bg-(--color-surface-muted) dark:hover:bg-(--color-surface-muted-dark) text-(--color-text-muted) hover:text-(--color-text-main)'
          }`}
        >
          {lang.toUpperCase()}
        </a>
      );
    })}
  </div>
</details>
