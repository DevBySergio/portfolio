---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getLinksContent } from "../../data/links";
import type { Language } from "../../i18n/ui";

type Props = {
  lang: Language;
};

const { lang } = Astro.props;
const content = getLinksContent(lang);

// Optional portrait: src/assets/images/personalImg.png
const personalImageModule = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/personalImg.png",
    { eager: true },
  ),
)[0];
const personalImage = personalImageModule?.default;
---

<section
  class="links-hub"
  aria-label={content.a11y.sectionLabel}
>
  <div class="ambient ambient-primary" aria-hidden="true"></div>
  <div class="ambient ambient-secondary" aria-hidden="true"></div>

  <header class="identity reveal" style="--delay: 40ms">
    <div class="monogram-shell" aria-hidden="true">
      <div class="portrait-clip">
        {
          personalImage ? (
            <Image
              src={personalImage}
              alt=""
              class="personal-image"
              widths={[144, 168]}
              sizes="(max-width: 639px) 72px, 84px"
            />
          ) : (
            <div class="monogram">S</div>
          )
        }
      </div>
      <span class="monogram-dot"></span>
    </div>

    <div class="identity-copy">
      <h1>{content.identity.name}</h1>
      <p>{content.identity.role}</p>
    </div>
  </header>

  <ul class="link-list">
    {
      content.links.map((link, index) => {
        const isExternal = link.behavior === "external";
        const ariaLabel =
          link.behavior === "email"
            ? content.a11y.sendEmail
            : `${content.a11y.open} ${link.title}${
                isExternal ? ` ${content.a11y.newTab}` : ""
              }`;

        return (
          <li
            class="link-item reveal"
            style={`--delay: ${140 + index * 70}ms`}
          >
            <a
              href={link.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              aria-label={ariaLabel}
              class:list={[
                "link-card",
                {
                  "link-card--featured": link.featured,
                  "link-card--external": isExternal,
                },
              ]}
            >
              <span class="link-index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="link-icon" aria-hidden="true">
                {link.icon === "home" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    focusable="false"
                  >
                    <path d="m3 11 9-8 9 8" />
                    <path d="M5 10v10h14V10" />
                    <path d="M9 20v-6h6v6" />
                  </svg>
                )}
                {link.icon === "linkedin" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    <path
                      fill-rule="evenodd"
                      d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                      clip-rule="evenodd"
                    />
                  </svg>
                )}
                {link.icon === "github" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    <path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"
                    />
                  </svg>
                )}
                {link.icon === "vscode" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    <path d="M23.15 2.587l-9.8.966-5.87-5.166L.867 7.032.55 16.968l6.913 8.646 5.87-5.167 9.8.967a1.67 1.67 0 0 0 1.867-1.67V4.257a1.67 1.67 0 0 0-1.85-1.67zM22 17.653l-8.623-1.313V7.66L22 6.35v11.303zm-11.623 2.06L4.032 23.08V.92L10.377 4.29v15.423z" />
                  </svg>
                )}
                {link.icon === "mail" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    focusable="false"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}
              </span>

              <span class="link-copy">
                <span class="link-title">{link.title}</span>
                <span class="link-subtitle">{link.subtitle}</span>
              </span>

              <span class="link-arrow" aria-hidden="true">
                {isExternal ? "↗" : "→"}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .links-hub {
    --links-accent-text: #c2410c;

    isolation: isolate;
    margin-inline: auto;
    max-width: 45rem;
    min-height: 78vh;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    position: relative;
  }

  :global(.dark) .links-hub {
    --links-accent-text: var(--color-brand);
  }

  .ambient {
    border-radius: 999px;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }

  .ambient-primary {
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-brand) 18%, transparent) 0%,
      color-mix(in srgb, var(--color-brand) 10%, transparent) 38%,
      transparent 72%
    );
    height: 30rem;
    right: 0.75rem;
    top: 0;
    width: 30rem;
  }

  .ambient-secondary {
    border: 1px solid
      color-mix(in srgb, var(--color-brand) 18%, var(--color-border));
    height: 11rem;
    left: -7rem;
    opacity: 0.5;
    top: 13rem;
    width: 11rem;
  }

  .identity {
    align-items: center;
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    margin-bottom: 2.75rem;
  }

  .monogram-shell {
    --monogram-radius: 1.65rem;

    align-items: center;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      linear-gradient(
          145deg,
          color-mix(in srgb, var(--color-brand) 85%, white),
          color-mix(in srgb, var(--color-brand) 12%, var(--color-border))
        )
        border-box;
    border: 1px solid transparent;
    border-radius: var(--monogram-radius);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.08);
    display: grid;
    height: 5.25rem;
    place-items: center;
    position: relative;
    transform: rotate(-3deg);
    width: 5.25rem;
  }

  .portrait-clip {
    border-radius: calc(var(--monogram-radius) - 1px);
    display: grid;
    inset: 1px;
    overflow: hidden;
    place-items: center;
    position: absolute;
  }

  .portrait-clip :global(.personal-image) {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: rotate(3deg) scale(1.1);
    width: 100%;
  }

  .monogram {
    color: var(--color-brand);
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 1;
    transform: rotate(3deg);
  }

  .monogram-dot {
    background: var(--color-brand);
    border: 3px solid var(--color-bg);
    border-radius: 999px;
    bottom: -0.2rem;
    height: 1rem;
    position: absolute;
    right: -0.2rem;
    width: 1rem;
  }

  .identity-copy {
    min-width: 0;
  }

  .identity h1 {
    color: var(--color-text-main);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 850;
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .identity p {
    color: var(--color-text-muted);
    font-size: clamp(0.9rem, 2.5vw, 1rem);
    font-weight: 600;
    line-height: 1.45;
    margin-top: 0.45rem;
  }

  .link-list {
    display: grid;
    gap: 0.9rem;
  }

  .link-card {
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    box-shadow: 0 0.45rem 1.5rem rgb(0 0 0 / 0.035);
    color: var(--color-text-main);
    display: grid;
    gap: 1rem;
    grid-template-columns: 2rem 3.25rem minmax(0, 1fr) 2rem;
    min-height: 5.75rem;
    padding: 1rem 1.25rem;
    position: relative;
    text-decoration: none;
  }

  .link-card--featured {
    background:
      radial-gradient(
        circle at 92% 15%,
        color-mix(in srgb, var(--color-brand) 22%, transparent),
        transparent 34%
      ),
      linear-gradient(
        105deg,
        color-mix(in srgb, var(--color-brand) 8%, var(--color-surface)),
        var(--color-surface) 62%
      );
    border-color: color-mix(
      in srgb,
      var(--color-brand) 48%,
      var(--color-border)
    );
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.07);
    min-height: 7rem;
  }

  .link-card--featured::after {
    background: var(--color-brand);
    border-radius: 999px;
    bottom: 1.15rem;
    content: "";
    position: absolute;
    right: 1.15rem;
    top: 1.15rem;
    width: 3px;
  }

  .link-index {
    color: color-mix(
      in srgb,
      var(--color-text-muted) 78%,
      var(--color-border)
    );
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    font-weight: 850;
    letter-spacing: 0.14em;
  }

  .link-card--featured .link-index {
    color: var(--links-accent-text);
  }

  .link-icon {
    align-items: center;
    background: var(--color-surface-muted);
    border: 1px solid
      color-mix(in srgb, var(--color-border) 76%, transparent);
    border-radius: 0.95rem;
    color: var(--color-text-main);
    display: flex;
    height: 3.25rem;
    justify-content: center;
    width: 3.25rem;
  }

  .link-card--featured .link-icon {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #18181b;
  }

  .link-icon svg {
    height: 1.45rem;
    width: 1.45rem;
  }

  .link-copy {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .link-title {
    color: var(--color-text-main);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .link-card--featured .link-title {
    font-size: 1.2rem;
  }

  .link-subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .link-arrow {
    color: var(--color-text-muted);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1;
    text-align: center;
  }

  .link-card--featured .link-arrow {
    color: var(--color-brand);
    padding-right: 0.3rem;
  }

  .link-card:focus-visible {
    border-color: var(--color-brand);
    outline: 3px solid
      color-mix(in srgb, var(--color-brand) 38%, transparent);
    outline-offset: 4px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .link-card:hover {
      border-color: color-mix(
        in srgb,
        var(--color-brand) 62%,
        var(--color-border)
      );
      box-shadow: 0 1rem 2.25rem rgb(0 0 0 / 0.08);
      transform: translateY(-3px);
    }

    .link-card:hover .link-icon {
      border-color: color-mix(
        in srgb,
        var(--color-brand) 38%,
        var(--color-border)
      );
      color: var(--color-brand);
    }

    .link-card--featured:hover .link-icon {
      color: #18181b;
      transform: rotate(-3deg) scale(1.03);
    }

    .link-card:hover .link-title {
      color: var(--links-accent-text);
    }

    .link-card:hover .link-arrow {
      color: var(--color-brand);
    }

    .link-card:hover .link-arrow {
      transform: translateX(0.2rem);
    }

    .link-card--external:hover .link-arrow {
      transform: translate(0.15rem, -0.15rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      animation: links-rise 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--delay, 0ms);
    }

    .ambient-primary {
      animation: ambient-drift 9s ease-in-out infinite alternate;
    }

    @keyframes links-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ambient-drift {
      from {
        transform: translate3d(0, 0, 0);
      }

      to {
        transform: translate3d(-1.5rem, 1rem, 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links-hub *,
    .links-hub *::before,
    .links-hub *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 39.99rem) {
    .links-hub {
      min-height: auto;
      padding-block: 3rem 4.5rem;
    }

    .identity {
      gap: 1rem;
      justify-content: flex-start;
      margin-bottom: 2.25rem;
    }

    .ambient-primary {
      height: 22rem;
      right: -1rem;
      top: 0;
      width: 20rem;
    }

    .monogram-shell {
      --monogram-radius: 1.35rem;

      flex: 0 0 auto;
      height: 4.5rem;
      width: 4.5rem;
    }

    .monogram {
      font-size: 1.75rem;
    }

    .link-list {
      gap: 0.75rem;
    }

    .link-card {
      border-radius: 1rem;
      gap: 0.75rem;
      grid-template-columns: 3rem minmax(0, 1fr) 1.5rem;
      min-height: 5.75rem;
      padding: 0.9rem;
    }

    .link-index {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.4rem;
      font-size: 0.55rem;
      left: 0.45rem;
      letter-spacing: 0.08em;
      padding: 0.1rem 0.2rem;
      position: absolute;
      top: 0.45rem;
      z-index: 1;
    }

    .link-card--featured .link-index {
      border-color: color-mix(
        in srgb,
        var(--color-brand) 42%,
        var(--color-border)
      );
    }

    .link-card--featured {
      min-height: 6.5rem;
    }

    .link-card--featured::after {
      bottom: 0.9rem;
      right: 0.7rem;
      top: 0.9rem;
    }

    .link-icon {
      border-radius: 0.8rem;
      height: 3rem;
      width: 3rem;
    }

    .link-title {
      font-size: 1rem;
    }

    .link-card--featured .link-title {
      font-size: 1.075rem;
    }

    .link-subtitle {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 20rem) {
    .link-card {
      grid-template-columns: 2.75rem minmax(0, 1fr) 1.25rem;
    }

    .link-index {
      display: none;
    }

    .link-icon {
      height: 2.75rem;
      width: 2.75rem;
    }
  }
</style>
