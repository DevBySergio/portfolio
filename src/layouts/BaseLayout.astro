---
import '../styles/global.css';
import DarkModeToggle from '../components/DarkModeToggle';
import LanguagePicker from '../components/LanguagePicker.astro';
import { languages, type Language } from '../i18n/ui';
import { getLangFromUrl, localizedPath, stripLocalePrefix, useTranslations } from '../i18n/utils';

type SEO = {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
};

const {
  title = 'Sergio – Full-stack Developer',
  seo,
} = Astro.props;
const SITE_URL = 'https://devbysergio.com';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = stripLocalePrefix(Astro.url.pathname);
const canonicalPath = localizedPath(lang, basePath);
const alternateLinks = Object.keys(languages).map((language) => ({
  lang: language as Language,
  href: SITE_URL + localizedPath(language as Language, basePath),
}));
const themeLabels = {
  light: t('theme.light'),
  dark: t('theme.dark'),
  toggle: t('theme.toggle'),
};

const metaTitle = seo?.title ?? title;
const metaDescription = seo?.description ?? t('meta.description');
const metaImage = seo?.image ? SITE_URL + seo.image : undefined;
const metaUrl = SITE_URL + canonicalPath;

// Schema.org JSON-LD para SEO Senior
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sergio",
  "url": SITE_URL,
  "jobTitle": "Full-stack Developer",
  "sameAs": [
    "https://github.com/DevBySergio",
    "https://www.linkedin.com/in/sergio-del-cerro-32405238a/"
  ],
  "description": metaDescription
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={metaUrl} />
    {alternateLinks.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={SITE_URL + localizedPath('en', basePath)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    {metaImage && <meta property="og:image" content={metaImage} />}
    <meta property="og:url" content={metaUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {metaImage && <meta name="twitter:image" content={metaImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') document.documentElement.classList.add('dark');
      else document.documentElement.classList.remove('dark');
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="flex flex-col min-h-screen bg-(--color-bg) text-(--color-text-main)">
    
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-100 px-4 py-2 bg-(--color-brand) text-white font-bold rounded">
      {t('a11y.skipToContent')}
    </a>

    <header
      class="sticky top-0 z-50 w-full border-b border-transparent transition-all duration-300
             bg-white/80 dark:bg-(--color-bg)/80 backdrop-blur-md
             hover:border-(--color-border) dark:hover:border-(--color-border-dark)"
    >
      <div class="max-w-7xl mx-auto px-6 h-16 flex justify-between items-center">
        <a href={localizedPath(lang, '/')} class="group flex items-center gap-1 text-xl font-bold tracking-tighter hover:opacity-80 transition-opacity z-50">
          <span class="text-(--color-brand)">DEV</span>
          <span class="text-sm font-light text-(--color-text-muted) px-1">BY</span>
          <span class="text-(--color-text-main)">SERGIO</span>
        </a>

        <div class="hidden md:flex items-center gap-8">
          <nav class="flex gap-8 text-sm font-medium text-(--color-text-muted)">
            <a href={localizedPath(lang, "/")} class="hover:text-(--color-brand) transition-colors">{t('nav.home')}</a>
            <a href={localizedPath(lang, "/projects")} class="hover:text-(--color-brand) transition-colors">{t('nav.projects')}</a>
            <a href={localizedPath(lang, "/about")} class="hover:text-(--color-brand) transition-colors">{t('nav.about')}</a>
          </nav>
          <LanguagePicker currentLang={lang} pathname={Astro.url.pathname} label={t('language.label')} />
          <div class="h-6 w-px bg-(--color-border) dark:bg-(--color-border-dark)"></div>
          <DarkModeToggle labels={themeLabels} client:load />
        </div>

        <div class="flex items-center gap-4 md:hidden">
            <DarkModeToggle labels={themeLabels} client:load />
            <button
              id="menu-toggle"
              aria-label={t('a11y.toggleMenu')}
              aria-controls="mobile-menu"
              aria-expanded="false"
              class="p-2 -mr-2 text-(--color-text-main)"
            >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden absolute top-16 left-0 w-full bg-(--color-bg) border-b border-(--color-border) dark:border-(--color-border-dark) shadow-lg animate-in slide-in-from-top-2">
          <nav class="flex flex-col p-6 gap-4 text-lg font-medium text-(--color-text-main)">
            <a href={localizedPath(lang, "/")} class="hover:text-(--color-brand)">{t('nav.home')}</a>
            <a href={localizedPath(lang, "/projects")} class="hover:text-(--color-brand)">{t('nav.projects')}</a>
            <a href={localizedPath(lang, "/about")} class="hover:text-(--color-brand)">{t('nav.about')}</a>
          </nav>
          <div class="px-6 pb-6">
            <LanguagePicker currentLang={lang} pathname={Astro.url.pathname} label={t('language.label')} />
          </div>
      </div>
    </header>

    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-6 focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <footer class="mt-auto border-t border-(--color-border) dark:border-(--color-border-dark)">
      <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-(--color-text-muted)">
        <span>{new Date().getFullYear()} Sergio · {t('footer.builtWith')}</span>
        <div class="flex gap-6">
            <a href="https://github.com/DevBySergio" target="_blank" rel="noreferrer" class="hover:text-(--color-brand)">{t('footer.github')}</a>
            <a href="https://www.linkedin.com/in/sergio-del-cerro-32405238a" target="_blank" rel="noreferrer" class="hover:text-(--color-brand)">{t('footer.linkedin')}</a>
        </div>
      </div>
    </footer>

    <script>
        const menuBtn = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn?.addEventListener('click', () => {
            const isHidden = mobileMenu?.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', String(!isHidden));
        });
    </script>
  </body>
</html>
