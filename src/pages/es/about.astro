---
import BaseLayout from '../../layouts/BaseLayout.astro';

const seo = {
  title: 'Sobre mí – Sergio | Desarrollador Full-stack',
  description:
    'Desarrollador full-stack con experiencia en proyectos reales, herramientas para desarrolladores y aplicaciones basadas en datos. Enfocado en soluciones escalables y mantenibles.',
  url: 'https://devbysergio.com/es/about',
};
---

<BaseLayout title="DbS · Sobre mí" seo={seo}>
  <section class="py-24 max-w-3xl">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-8 text-(--color-text-main)">
      Sobre mí
    </h1>

    <div class="space-y-6 text-lg text-(--color-text-muted) leading-relaxed">
        <p>
        Soy un desarrollador full-stack con experiencia creando aplicaciones
        reales, herramientas internas y productos orientados a desarrolladores.
        Mi trabajo se define por un fuerte enfoque en resolver problemas
        concretos mediante soluciones escalables y mantenibles.
        </p>

        <p>
        Disfruto trabajando en todas las capas del stack, desde el diseño de
        sistemas y la lógica de backend hasta interfaces frontend limpias y con
        propósito.
        </p>
    </div>
  </section>

  <section class="py-20 border-t border-(--color-border) dark:border-(--color-border-dark) max-w-3xl">
    <h2 class="text-2xl font-bold mb-8 text-(--color-text-main)">
      Cómo trabajo
    </h2>

    <ul class="space-y-6">
      <li class="flex gap-4 items-start">
        <span class="mt-2 w-1.5 h-1.5 rounded-full bg-(--color-brand) shrink-0"></span>
        <span class="text-(--color-text-muted) text-lg">Me centro en entender el problema antes de elegir la tecnología.</span>
      </li>
      <li class="flex gap-4 items-start">
        <span class="mt-2 w-1.5 h-1.5 rounded-full bg-(--color-brand) shrink-0"></span>
        <span class="text-(--color-text-muted) text-lg">Valoro la claridad, la mantenibilidad y el impacto a largo plazo por encima de soluciones rápidas.</span>
      </li>
      <li class="flex gap-4 items-start">
        <span class="mt-2 w-1.5 h-1.5 rounded-full bg-(--color-brand) shrink-0"></span>
        <span class="text-(--color-text-muted) text-lg">Disfruto mejorando flujos de trabajo y creando herramientas que hacen más productivos a los desarrolladores.</span>
      </li>
      <li class="flex gap-4 items-start">
        <span class="mt-2 w-1.5 h-1.5 rounded-full bg-(--color-brand) shrink-0"></span>
        <span class="text-(--color-text-muted) text-lg">Me siento cómodo trabajando de forma autónoma y alineado con objetivos de equipo y negocio.</span>
      </li>
    </ul>
  </section>

  <section class="py-20 border-t border-(--color-border) dark:border-(--color-border-dark)">
    <h2 class="text-2xl font-bold mb-10 text-(--color-text-main)">
      Enfoque técnico
    </h2>

    <div class="grid md:grid-cols-2 gap-12">
      <div class="p-8 rounded-2xl bg-white dark:bg-(--color-surface-dark) border border-(--color-border) dark:border-(--color-border-dark) shadow-sm dark:shadow-none">
        <h3 class="font-bold text-lg mb-6 text-(--color-text-main) flex items-center gap-2">
            Stack principal
        </h3>
        <ul class="space-y-4 text-(--color-text-muted)">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-(--color-brand)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            TypeScript / JavaScript
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-(--color-brand)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            React, Astro, Next.js
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-(--color-brand)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Node.js
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-(--color-brand)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            SQL & relational databases
          </li>
        </ul>
      </div>

      <div class="p-8 rounded-2xl bg-white dark:bg-(--color-surface-dark) border border-(--color-border) dark:border-(--color-border-dark) shadow-sm dark:shadow-none">
        <h3 class="font-bold text-lg mb-6 text-(--color-text-main)">
          Experiencia adicional
        </h3>
        <ul class="space-y-4 text-(--color-text-muted)">
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-(--color-text-muted)"></span>
            Herramientas para desarrolladores (extensiones de VS Code)
          </li>
          <li class="flex items-center gap-3">
             <span class="w-1.5 h-1.5 rounded-full bg-(--color-text-muted)"></span>
            Proyectos basados en datos y relacionados con IA
          </li>
          <li class="flex items-center gap-3">
             <span class="w-1.5 h-1.5 rounded-full bg-(--color-text-muted)"></span>
            Cloudflare y despliegue moderno
          </li>
          <li class="flex items-center gap-3">
             <span class="w-1.5 h-1.5 rounded-full bg-(--color-text-muted)"></span>
            Arquitecturas centradas en rendimiento y DX
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-20 border-t border-(--color-border) dark:border-(--color-border-dark) max-w-3xl">
    <h2 class="text-2xl font-bold mb-6 text-(--color-text-main)">
      Qué estoy buscando
    </h2>

    <p class="text-(--color-text-muted) mb-4 leading-relaxed">
      Me interesa trabajar con equipos que valoren la calidad de ingeniería,
      el diseño cuidadoso de sistemas y la mejora continua.
    </p>

    <p class="text-(--color-text-muted) leading-relaxed">
      Me motivan especialmente los entornos donde pueda crecer hacia un rol
      senior, contribuir a productos con sentido y colaborar en un contexto
      internacional.
    </p>
  </section>

  <section class="py-20 border-t border-(--color-border) dark:border-(--color-border-dark)">
    <h2 class="text-2xl font-bold mb-8 text-(--color-text-main)">
      Encuéntrame online
    </h2>

    <ul class="flex flex-col sm:flex-row gap-6 text-base font-medium">
      <li>
        <a
          href="https://github.com/DevBySergio"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2 text-(--color-text-main) hover:text-(--color-brand) transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          GitHub
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/sergio-del-cerro-32405238a/"
          target="_blank"
          rel="noreferrer"
           class="flex items-center gap-2 text-(--color-text-main) hover:text-(--color-brand) transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"></path></svg>
          LinkedIn
        </a>
      </li>
      <li>
        <a
          href="https://marketplace.visualstudio.com/publishers/DevBySergio"
          target="_blank"
          rel="noreferrer"
           class="flex items-center gap-2 text-(--color-text-main) hover:text-(--color-brand) transition-colors"
        >
           <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.15 2.587l-9.8.966-5.87-5.166L.867 7.032.55 16.968l6.913 8.646 5.87-5.167 9.8.967a1.67 1.67 0 0 0 1.867-1.67V4.257a1.67 1.67 0 0 0-1.85-1.67zM22 17.653l-8.623-1.313V7.66L22 6.35v11.303zm-11.623 2.06L4.032 23.08V.92L10.377 4.29v15.423z"/></svg>
          VS Code Marketplace
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
