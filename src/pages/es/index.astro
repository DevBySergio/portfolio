---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../data/projects";
import { localizedPath } from "../../i18n/utils";

const lang = "es";
const projects = getProjects(lang);
const featured = projects.filter((p) => p.type === "featured");
// 🟢 VARIABLE DE ESTADO: Cambia a false cuando encuentres trabajo
const isOpenToWork = true;
---

<BaseLayout title="DbS · Software Developer">
  <section
    class="py-24 md:py-22 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center"
  >
    <div class="flex flex-col justify-center gap-8">
      <div class="space-y-4">
        <h1 class="font-extrabold leading-tight tracking-tight">
          <span
            class="block text-5xl md:text-7xl lg:text-6xl xl:text-7xl text-(--color-text-main)"
          >
            Sergio del Cerro
          </span>
          <span
            class="block text-4xl md:text-5xl lg:text-4xl xl:text-5xl text-transparent bg-clip-text bg-linear-to-r from-(--color-brand) to-orange-400 mt-1 md:mt-2"
          >
            Desarrollador Full-Stack
          </span>
        </h1>
      </div>

      <p class="max-w-xl text-xl text-(--color-text-muted) leading-relaxed">
        Desarrollo aplicaciones web y herramientas de alto rendimiento y
        escalables, con el compromiso de ofrecer una experiencia de
        desarrollador excepcional.
      </p>

      <div class="flex flex-wrap gap-4 mt-2">
        <a
          href={localizedPath(lang, "/projects")}
          class="px-8 py-3.5 rounded-lg font-semibold text-gray-900
                 bg-(--color-brand) hover:bg-(--color-brand-dark) hover:text-white
                 transition-colors shadow-sm"
        >
          Ver Proyectos
        </a>

        <a
          href={localizedPath(lang, "/projects#extensions")}
          class="px-8 py-3.5 rounded-lg font-medium
                 bg-white dark:bg-(--color-surface-muted)
                 text-(--color-text-main)
                 border border-(--color-border) dark:border-(--color-border-dark)
                 hover:border-(--color-brand) dark:hover:border-(--color-brand)
                 transition-colors shadow-sm"
        >
          Extensiones VS Code
        </a>
      </div>
    </div>

    <div class="hidden lg:flex relative justify-end w-full">
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 bg-orange-500/10 rounded-full blur-3xl -z-10"
      >
      </div>

      <div
        class="w-full max-w-115 bg-[#fafafa] dark:bg-[#0d1117] rounded-xl border border-gray-200 dark:border-gray-800 shadow-xl shadow-black/5 dark:shadow-2xl overflow-hidden"
      >
        <div
          class="bg-gray-100 dark:bg-[#161b22] px-4 py-3 flex items-center gap-2 border-b border-gray-200 dark:border-gray-800"
        >
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <span class="ml-3 text-xs font-mono text-gray-500 dark:text-gray-400"
            >developer.ts</span
          >
        </div>

        <div
          class="py-6 font-mono text-sm text-gray-800 dark:text-gray-300 leading-relaxed overflow-x-auto"
        >
          <p class="px-6">
            <span class="text-blue-600 dark:text-pink-400">const</span>
            <span class="text-gray-900 dark:text-blue-400">sergio</span>
            <span class="text-gray-500 dark:text-pink-400">=</span>
            <span class="text-blue-600 dark:text-yellow-300">new</span>
            <span class="text-teal-600 dark:text-emerald-400">Developer</span
            >(&#123;
          </p>
          <p class="px-6 pl-10">
            <span class="text-blue-500 dark:text-blue-300">role:</span>
            <span class="text-red-700 dark:text-orange-300">'Full-Stack'</span>,
          </p>
          <p class="px-6 pl-10">
            <span class="text-blue-500 dark:text-blue-300">focus:</span> [
          </p>
          <p class="px-6 pl-14">
            <span class="text-red-700 dark:text-orange-300"
              >'Scalable Architectures'</span
            >,
          </p>
          <p class="px-6 pl-14">
            <span class="text-red-700 dark:text-orange-300"
              >'Developer Tooling'</span
            >,
          </p>
          <p class="px-6 pl-14">
            <span class="text-red-700 dark:text-orange-300"
              >'Exceptional UX'</span
            >
          </p>
          <p class="px-6 pl-10">],</p>

          {
            isOpenToWork ? (
              <div class="pl-10 py-1 my-1 bg-green-500/5 border-l-4 border-green-500 relative flex items-center">
                <span class="ml-6 flex items-center">
                  <span class="text-blue-500 dark:text-blue-300 mr-2">
                    status:
                  </span>

                  <span class="relative inline-block font-bold">
                    <span class="text-gray-400/50 dark:text-gray-500/50">
                      'Abierto a nuevos proyectos'
                    </span>

                    <span class="absolute left-0 top-0 h-full overflow-hidden whitespace-nowrap text-green-700 dark:text-green-400 border-r-2 border-green-500 dark:border-green-400 animate-ide-typing">
                      'Abierto a nuevos proyectos'
                    </span>
                  </span>

                  <span class="text-gray-800 dark:text-gray-300 ml-1">,</span>
                </span>

                <span class="ml-4 flex relative h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75" />
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500" />
                </span>
              </div>
            ) : (
              <p class="px-6 pl-10">
                <span class="text-blue-500 dark:text-blue-300">status:</span>{" "}
                <span class="text-red-700 dark:text-orange-300">
                  'Building awesome stuff'
                </span>
                ,
              </p>
            )
          }

          <p class="px-6">&#125;);</p>
          <br />
          <p class="px-6">
            <span class="text-gray-900 dark:text-blue-400">sergio</span>.<span
              class="text-purple-700 dark:text-yellow-200">execute</span
            >();
          </p>

          <p
            class="px-6 mt-2 text-gray-400 dark:text-gray-500 flex items-center gap-1"
          >
            > <span
              class="inline-block w-2 h-4 bg-gray-400 dark:bg-gray-500 animate-pulse"
            ></span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="py-24 border-t border-(--color-border) dark:border-(--color-border-dark)"
  >
    <h2 class="sr-only">Mis pilares de desarrollo</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div
        class="p-6 rounded-2xl bg-white dark:bg-(--color-surface-dark) border border-(--color-border) dark:border-transparent hover:border-(--color-brand)/50 transition-colors duration-300 shadow-sm"
      >
        <div
          class="w-10 h-10 mb-4 rounded bg-(--color-brand)/10 flex items-center justify-center text-(--color-brand)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-lightbulb"
            viewBox="0 0 16 16"
          >
            <path
              d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a2 2 0 0 0-.453-.618A5.98 5.98 0 0 1 2 6m6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1"
            ></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold mb-2 text-(--color-text-main)">
          Mentalidad de producto
        </h3>
        <p class="text-(--color-text-muted)">
          Experiencia creando soluciones para clientes reales, con foco en el
          impacto de negocio y la usabilidad.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-white dark:bg-(--color-surface-dark) border border-(--color-border) dark:border-transparent hover:border-(--color-brand)/50 transition-colors duration-300 shadow-sm"
      >
        <div
          class="w-10 h-10 mb-4 rounded bg-(--color-brand)/10 flex items-center justify-center text-(--color-brand)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
            ></path></svg
          >
        </div>
        <h3 class="text-lg font-bold mb-2 text-(--color-text-main)">
          Herramientas de desarrollo
        </h3>
        <p class="text-(--color-text-muted)">
          Extensiones de VS Code y herramientas internas que mejoran la
          productividad y los flujos de trabajo.
        </p>
      </div>

      <div
        class="p-6 rounded-2xl bg-white dark:bg-(--color-surface-dark) border border-(--color-border) dark:border-transparent hover:border-(--color-brand)/50 transition-colors duration-300 shadow-sm"
      >
        <div
          class="w-10 h-10 mb-4 rounded bg-(--color-brand)/10 flex items-center justify-center text-(--color-brand)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="16 18 22 12 16 6"></polyline><polyline
              points="8 6 2 12 8 18"></polyline></svg
          >
        </div>
        <h3 class="text-lg font-bold mb-2 text-(--color-text-main)">
          Arquitectura escalable
        </h3>
        <p class="text-(--color-text-muted)">
          Código limpio, sistemas mantenibles y decisiones de ingeniería
          pragmáticas.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="flex items-end justify-between mb-8">
      <h2 class="text-3xl font-bold text-(--color-text-main)">
        Proyectos destacados
      </h2>
      <a
        href={localizedPath(lang, "/projects")}
        class="hidden md:inline-block text-sm font-medium text-(--color-brand) hover:text-(--color-brand-dark) hover:underline"
      >
        Ver todos los proyectos →
      </a>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {
        featured.map((project) => (
          <article
            class="group relative flex flex-col p-8 rounded-2xl
                   bg-white dark:bg-(--color-surface-dark)
                   border border-(--color-border) dark:border-(--color-border-dark)
                   hover:border-(--color-brand) dark:hover:border-(--color-brand)
                   shadow-sm transition-colors duration-300"
          >
            <h3 class="text-2xl font-bold mb-3 text-(--color-text-main) group-hover:text-(--color-brand) transition-colors">
              {project.title}
            </h3>
            <p class="text-(--color-text-muted) mb-6 flex-1">
              {project.summary}
            </p>
            <div class="mt-auto">
              <span class="inline-flex items-center text-sm font-semibold text-(--color-brand)">
                Ver proyecto
                <span class="ml-2 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out">
                  →
                </span>
              </span>
            </div>
            <a
              href={localizedPath(lang, `/projects/${project.id}`)}
              class="absolute inset-0 z-10"
              aria-label={`Ver proyecto ${project.title}`}
            />
          </article>
        ))
      }
    </div>

    <div class="mt-8 text-center md:hidden">
      <a
        href={localizedPath(lang, "/projects")}
        class="text-sm font-medium text-(--color-brand)"
        >Ver todos los proyectos →</a
      >
    </div>
  </section>

  <section
    class="py-24 border-t border-(--color-border) dark:border-(--color-border-dark)"
  >
    <div
      class="bg-(--color-surface-muted) dark:bg-(--color-surface-dark) rounded-2xl p-8 md:p-12 text-center border border-(--color-border) dark:border-transparent"
    >
      <h2 class="text-3xl font-bold mb-4 text-(--color-text-main)">
        Herramientas de Desarrollo
      </h2>

      <p class="max-w-xl mx-auto text-(--color-text-muted) mb-8">
        Una colección de extensiones para VS Code enfocadas en resolver
        problemas reales de desarrollo y optimizar los flujos de trabajo
        diarios.
      </p>

      <a
        href={localizedPath(lang, "/projects#extensions")}
        class="inline-block px-6 py-3 rounded-lg text-sm font-medium
         bg-(--color-brand) text-gray-900
         hover:bg-(--color-brand-dark) hover:text-white transition-colors"
      >
        Ver extensiones
      </a>
    </div>
  </section>
</BaseLayout>
